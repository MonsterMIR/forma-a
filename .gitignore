# Секреты и окружение — никогда не коммитим
.env
.env.*
!.env.example

# Зависимости (ставятся через composer install по composer.lock)
/vendor/
composer.phar

# Пользовательские файлы, логи, бэкапы прошлых раундов (реальные
# производственные данные, PII — не место в git)
/storage/
/private/

# Старые ручные поштучные бэкапы файлов (.bak-roundNNN) — начиная с этого
# коммита их роль берёт на себя сама история git, новые такие файлы не
# создаём и в репозиторий не кладём.
*.bak
*.bak-*
*.before
*.before_*

# ОС/редакторы
.DS_Store
*.swp
*.swo
